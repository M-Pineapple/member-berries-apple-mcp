{
  "name": "member-berries-apple-mcp",
  "version": "2.1.4",
  "type": "module",
  "description": "Member Berries — a friendly Apple MCP for Calendar, Notes, and Reminders with local day-memory",
  "author": "Pineapple (M-Pineapple)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-Pineapple/member-berries-apple-mcp.git",
    "directory": "member-berries"
  },
  "bugs": {
    "url": "https://github.com/M-Pineapple/member-berries-apple-mcp/issues"
  },
  "homepage": "https://github.com/M-Pineapple/member-berries-apple-mcp#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "apple",
    "macos",
    "calendar",
    "notes",
    "reminders",
    "claude",
    "cursor",
    "member-berries"
  ],
  "main": "./dist/index.js",
  "bin": {
    "member-berries-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CLAUDE_PROMPT_SETUP.md"
